 using Printf: @printf, @sprintf
+
+# --comm NCCL: load NCCL.jl (Oceananigans' NCCL extension, NCCLDistributed) before anything runs.
+# NCCL.jl must be in this environment (Pkg.add("NCCL")); MPI runs never load it.
+const USE_NCCL = let i = findfirst(a -> a == "--comm" || startswith(a, "--comm="), ARGS)
+    i === nothing ? false :
+    uppercase(ARGS[i] == "--comm" ? get(ARGS, i + 1, "") : split(ARGS[i], '=', limit=2)[2]) == "NCCL"
+end
+USE_NCCL && @eval using NCCL
+
+# The MPI communicator of an architecture (NCCLDistributed wraps it, with the NCCL communicator).
+mpi_communicator(arch) = hasproperty(arch.communicator, :mpi) ? arch.communicator.mpi : arch.communicator
